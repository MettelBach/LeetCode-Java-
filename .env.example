# Product name used in e-mails
BRAND_NAME=SellHub

# Public address of the panel (used in e-mails and order links)
APP_URL=https://panel.example.com
# Random string, at least 32 characters: openssl rand -hex 32
JWT_SECRET=
PORT=3001
DATA_DIR=/data

# Super-administrator of the support panel (/admin), created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Platform e-mail (registration, password reset, support replies)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SellHub <no-reply@example.com>"

# Sign-up and trial
ALLOW_SIGNUP=1
TRIAL_DAYS=14

# Payment details shown to clients (Settings → Subscription)
PLATFORM_COMPANY="SellHub Sp. z o.o."
PLATFORM_BANK_ACCOUNT=

# Only when the frontend is served from another domain
# CORS_ORIGIN=https://panel.example.com
